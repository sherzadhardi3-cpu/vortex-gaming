# ─── VORTEX GAMING — Render Staging Environment Configuration ──────────────────
# Use this template when configuring environment variables in the Render Dashboard
# or when deploying to a private staging Web Service on Render.
# NEVER commit populated credentials to source control.

# ─── Service Runtime & Port (Injected automatically by Render) ────────────────
NODE_ENV="production"
APP_ENV="staging"
FORCE_SANDBOX="true"
# Render automatically sets PORT (typically 10000). The app binds to it automatically.
PORT=10000

# ─── Application Branding & Public URL ────────────────────────────────────────
# Replace with your actual Render Web Service URL once provisioned
NEXT_PUBLIC_APP_URL="https://vortex-gaming-staging.onrender.com"
NEXT_PUBLIC_APP_NAME="VORTEX GAMING (Staging)"
NEXT_PUBLIC_APP_ENV="staging"

# ─── External PostgreSQL Persistence (Render PostgreSQL or External) ────────
# In Render, use the internal database connection string:
# postgresql://vortex_user:<password>@dpg-<id>-a.oregon-postgres.render.com/vortex_gaming_staging
DATABASE_URL="postgresql://user:password@hostname:5432/vortex_staging?sslmode=require"

# ─── Authentication Security (AES-256 / HMAC) ─────────────────────────────────
# Minimum 32-character high-entropy secret.
# Generate on Linux/macOS/Git Bash: openssl rand -hex 32
# Or on Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="REPLACE_WITH_CSPRNG_HEX_STRING_MIN_32_CHARS"
AUTH_URL="https://vortex-gaming-staging.onrender.com"
SESSION_MAX_AGE=86400

# ─── Game Key Vault Encryption (CSPRNG 256-Bit Key) ──────────────────────────
# CRITICAL: 64-character hexadecimal string (256 bits).
# Generate on Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAME_KEY_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHAR_256_BIT_CSPRNG_KEY"
# Optional previous key for zero-downtime key rotation
GAME_KEY_ENCRYPTION_KEY_PREVIOUS=""

# ─── Discord OAuth2 (Sandbox / Staging App) ──────────────────────────────────
# Register a Staging App at https://discord.com/developers/applications
# Redirect URI: https://vortex-gaming-staging.onrender.com/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ─── Discord Support Bot (Two-Way Live Support) ────────────────────────────────
DISCORD_GUILD_ID=""
DISCORD_SUPPORT_CHANNEL_ID=""
DISCORD_BOT_TOKEN=""

# ─── Payment Processing (STRICT SANDBOX / TEST MODE ONLY) ────────────────────
# Use test keys from https://dashboard.stripe.com/test/apikeys
# DO NOT USE LIVE KEYS (sk_live_...) IN STAGING.
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Regional Iraqi Gateways (Maintained strictly in sandbox adapter mode)
FIB_API_URL="https://sandbox.fib.iq"
FASTPAY_API_URL="https://sandbox.fast-pay.cash"
QI_CARD_API_URL="https://sandbox.qi.iq"

# ─── Safe Initial Staging Administrator (Auto-provisioned if set) ─────────────
# Set to securely provision the initial admin without hardcoded credentials.
# Password must be at least 12 characters with uppercase, lowercase, digit, and symbol.
INITIAL_ADMIN_EMAIL="staging-admin@vortexgaming.gg"
INITIAL_ADMIN_PASSWORD="StagingAdmin2026!#SecurePass"

# ─── Rate Limiting & Health ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
