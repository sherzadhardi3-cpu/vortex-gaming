# ─── VORTEX GAMING — Environment Configuration ───────────────────────────────
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to source control

# ─── Environment & Sandbox Isolation ─────────────────────────────────────────
# In staging or test environments, FORCE_SANDBOX must ALWAYS be true.
# Set FORCE_SANDBOX="false" ONLY when production merchant accounts are certified.
APP_ENV="staging"
FORCE_SANDBOX="true"

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vortex_gaming?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET="CHANGE_ME_GENERATE_A_SECURE_SECRET"
AUTH_URL="http://localhost:3000"

# ─── Discord OAuth2 ──────────────────────────────────────────────────────────
# Register in Discord Developer Portal: https://discord.com/developers/applications
# Exact Redirect URI: http://localhost:3000/api/auth/discord/callback
# (Also supports alias: http://localhost:3000/api/auth/callback/discord)
# Scopes requested: "identify email"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Session duration in seconds (default: 24 hours)
SESSION_MAX_AGE=86400

# ─── Game Key Encryption ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Store this securely. Loss means losing access to all encrypted keys.
GAME_KEY_ENCRYPTION_KEY="CHANGE_ME_GENERATE_A_32_BYTE_HEX_KEY"

# ─── Payment Gateways ────────────────────────────────────────────────────────

# 1. Stripe (International Visa & Mastercard)
# Sandbox keys start with pk_test_ / sk_test_
# Webhook URL: https://<domain>/api/webhooks/stripe
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 2. First Iraqi Bank (FIB) QR Payment
# Merchant Onboarding: Apply at https://fib.iq
# Sandbox Base: https://fib.stage.firstiraqibank.com
# Production Base: https://api.firstiraqibank.com
# Webhook URL: https://<domain>/api/webhooks/fib
FIB_API_URL="https://fib.stage.firstiraqibank.com"
FIB_CLIENT_ID=""
FIB_CLIENT_SECRET=""
FIB_API_KEY=""
FIB_API_SECRET=""

# 3. FastPay Mobile Wallet (Iraq)
# Merchant Onboarding: Register via FastPay Merchant Services
# Staging Base: https://staging-apigw-merchant.fast-pay.iq
# Production Base: https://apiv2.fast-pay.iq
# Webhook URL: https://<domain>/api/webhooks/fastpay
FASTPAY_API_URL="https://staging-apigw-merchant.fast-pay.iq"
FASTPAY_STORE_ID=""
FASTPAY_STORE_PASSWORD=""
FASTPAY_MERCHANT_ID=""
FASTPAY_API_KEY=""
FASTPAY_MERCHANT_CODE="892401"

# 4. Qi Card / CBI Iraqi Local Cards Gateway
# Merchant Onboarding: International Smart Card (ISC / Qi Card - https://qi.iq)
# Webhook URL: https://<domain>/api/webhooks/qi-card
QI_CARD_API_URL=""
QI_CARD_MERCHANT_ID=""
QI_CARD_SECRET_KEY=""

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="VORTEX GAMING"

# ─── Email (for notifications) ───────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@vortexgaming.com"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Redis (optional, for production caching/rate-limiting) ──────────────────
REDIS_URL=""

# ─── Node Environment ────────────────────────────────────────────────────────
NODE_ENV="development"
