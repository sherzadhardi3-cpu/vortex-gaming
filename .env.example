# ─── VORTEX GAMING — Environment Configuration ───────────────────────────────
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to source control

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vortex_gaming?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET="CHANGE_ME_GENERATE_A_SECURE_SECRET"
AUTH_URL="http://localhost:3000"

# ─── Discord OAuth2 ──────────────────────────────────────────────────────────
# Register in Discord Developer Portal: https://discord.com/developers/applications
# Exact Redirect URI: http://localhost:3000/api/auth/discord/callback
# (Also supports alias: http://localhost:3000/api/auth/callback/discord)
# Scopes requested: "identify email"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Session duration in seconds (default: 24 hours)
SESSION_MAX_AGE=86400

# ─── Game Key Encryption ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Store this securely. Loss means losing access to all encrypted keys.
GAME_KEY_ENCRYPTION_KEY="CHANGE_ME_GENERATE_A_32_BYTE_HEX_KEY"

# ─── Payment Providers ───────────────────────────────────────────────────────
# Stripe (sandbox mode)
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# FIB Payment — Sandbox adapter (requires merchant onboarding)
FIB_API_URL=""
FIB_API_KEY=""
FIB_API_SECRET=""

# FastPay — Sandbox adapter (requires merchant onboarding)
FASTPAY_API_URL=""
FASTPAY_API_KEY=""
FASTPAY_MERCHANT_ID=""

# Qi Card — Sandbox adapter (requires merchant onboarding)
QI_CARD_API_URL=""
QI_CARD_MERCHANT_ID=""
QI_CARD_SECRET_KEY=""

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="VORTEX GAMING"

# ─── Email (for notifications) ───────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@vortexgaming.com"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Redis (optional, for production caching/rate-limiting) ──────────────────
REDIS_URL=""

# ─── Node Environment ────────────────────────────────────────────────────────
NODE_ENV="development"
